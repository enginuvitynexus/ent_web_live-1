@page
@model Ent.Web.Pages.ContactModel
@{
    ViewData["Title"] = "Contact Us";
}

<div class="bg-white pt-12 pb-24 sm:pt-16 sm:pb-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">

    <!-- Page Header -->
    <div class="mx-auto max-w-2xl lg:text-center mb-16">
      <span class="inline-block text-xs font-bold tracking-widest text-violet-600 uppercase mb-3
                   px-3 py-1 rounded-full bg-violet-50 border border-violet-100">Contact</span>
      <p class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Let's discuss your <br/>
        <span class="text-slate-400 font-light">next innovation</span>
      </p>
      <p class="mt-8 text-lg leading-8 text-slate-500 font-medium">
        Whether you need an AI-driven solution, quantum engineering consultation, or enterprise software development, our team is ready to help.
      </p>
    </div>

    <div class="mx-auto max-w-5xl">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start">

        <!-- ── Contact Info Card ── -->
        <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <!-- Coloured top accent bar -->
          <div class="h-1 w-full" style="background:linear-gradient(90deg,#7c3aed,#06b6d4);"></div>
          <div class="p-8 flex flex-col gap-8">
            <div>
              <h3 class="text-base font-bold text-slate-900 uppercase tracking-widest mb-1">Get in Touch</h3>
              <p class="text-sm text-slate-400">We respond within 1 business day</p>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-violet-50 border border-violet-100 flex items-center justify-center">
                <svg class="h-5 w-5 text-violet-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Email</p>
                <a class="text-sm font-semibold text-slate-700 hover:text-violet-600 transition-colors" href="mailto:info@enginuvitynexus.com">info@enginuvitynexus.com</a>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center">
                <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.273-3.973-6.869-6.87l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Phone</p>
                <a class="text-sm font-semibold text-slate-700 hover:text-cyan-600 transition-colors" href="tel:+918075998325">+91 80759 98325</a>
              </div>
            </div>

            <!-- LinkedIn -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center">
                <svg class="h-5 w-5 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">LinkedIn</p>
                <a class="text-sm font-semibold text-slate-700 hover:text-violet-600 transition-colors" href="https://www.linkedin.com/company/enginuvity-nexus-technologies/" target="_blank" rel="noopener noreferrer">Enginuvity Nexus Technologies</a>
              </div>
            </div>

            <!-- Facebook -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center">
                <svg class="h-5 w-5 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.8c4.56-.93 8-4.96 8-9.8z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Facebook</p>
                <a class="text-sm font-semibold text-slate-700 hover:text-violet-600 transition-colors" href="https://www.facebook.com/profile.php?id=61563715481704" target="_blank" rel="noopener noreferrer">Enginuvity Nexus Technologies</a>
              </div>
            </div>

            <!-- Instagram -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center">
                <svg class="h-5 w-5 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Instagram</p>
                <a class="text-sm font-semibold text-slate-700 hover:text-violet-600 transition-colors" href="https://www.instagram.com/enginuvitynexus?igsh=dTh2ZTh2ZmtxYW8y" target="_blank" rel="noopener noreferrer">@@enginuvitynexus</a>
              </div>
            </div>

            <!-- Divider + note -->
            <div class="border-t border-slate-100 pt-6">
              <p class="text-xs text-slate-400 leading-relaxed">
                Headquartered in India &mdash; serving clients globally across engineering and technology sectors.
              </p>
            </div>
          </div>
        </div>

        <!-- ── Contact Form Card ── -->
        <div class="lg:col-span-3 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <!-- Coloured top accent bar -->
          <div class="h-1 w-full" style="background:linear-gradient(90deg,#06b6d4,#7c3aed);"></div>
          <div class="p-8">
            @if (Model.IsSuccess)
            {
              <div class="rounded-xl bg-green-50 p-6 border border-green-200 flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center">
                  <svg class="h-5 w-5 text-green-600" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-green-800 mb-1">Message sent successfully!</h3>
                  <p class="text-sm text-green-700">Thank you for reaching out. A member of our engineering team will get back to you within 1 business day.</p>
                </div>
              </div>
            }
            else if (Model.IsError)
            {
              <div class="rounded-xl bg-red-50 p-6 border border-red-200 flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-red-100 flex items-center justify-center">
                  <svg class="h-5 w-5 text-red-600" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm-1-9a1 1 0 012 0v4a1 1 0 01-2 0V9zm1-4a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-red-800 mb-1">Message could not be delivered</h3>
                  <p class="text-sm text-red-700">We're sorry — something went wrong sending your message. Please try again or email us directly at <a href="mailto:support@enginuvitynexus.com" class="underline font-semibold">support@enginuvitynexus.com</a>.</p>
                </div>
              </div>
            }
            else
            {
              <div class="mb-6">
                <h3 class="text-base font-bold text-slate-900 uppercase tracking-widest mb-1">Send a Message</h3>
                <p class="text-sm text-slate-400">Fill in the form and we'll be in touch</p>
              </div>
              <form method="post" class="space-y-5">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <!-- Name -->
                  <div>
                    <label asp-for="ContactForm.Name" class="block text-xs font-bold leading-6 text-slate-600 uppercase tracking-widest mb-1.5">Name</label>
                    <input asp-for="ContactForm.Name"
                           class="block w-full rounded-lg border border-slate-200 px-4 py-3 text-sm text-slate-900
                                  bg-slate-50 placeholder-slate-400
                                  focus:outline-none focus:border-violet-400 focus:ring-1 focus:ring-violet-400
                                  transition-all" placeholder="John Smith" />
                    <span asp-validation-for="ContactForm.Name" class="text-red-500 text-xs mt-1 block"></span>
                  </div>

                  <!-- Email -->
                  <div>
                    <label asp-for="ContactForm.Email" class="block text-xs font-bold leading-6 text-slate-600 uppercase tracking-widest mb-1.5">Email</label>
                    <input asp-for="ContactForm.Email" type="email"
                           class="block w-full rounded-lg border border-slate-200 px-4 py-3 text-sm text-slate-900
                                  bg-slate-50 placeholder-slate-400
                                  focus:outline-none focus:border-violet-400 focus:ring-1 focus:ring-violet-400
                                  transition-all" placeholder="john@company.com" />
                    <span asp-validation-for="ContactForm.Email" class="text-red-500 text-xs mt-1 block"></span>
                  </div>
                </div>

                <!-- Subject -->
                <div>
                  <label asp-for="ContactForm.Subject" class="block text-xs font-bold leading-6 text-slate-600 uppercase tracking-widest mb-1.5">Subject</label>
                  <input asp-for="ContactForm.Subject"
                         class="block w-full rounded-lg border border-slate-200 px-4 py-3 text-sm text-slate-900
                                bg-slate-50 placeholder-slate-400
                                focus:outline-none focus:border-violet-400 focus:ring-1 focus:ring-violet-400
                                transition-all" placeholder="How can we help?" />
                  <span asp-validation-for="ContactForm.Subject" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Message -->
                <div>
                  <label asp-for="ContactForm.Message" class="block text-xs font-bold leading-6 text-slate-600 uppercase tracking-widest mb-1.5">Message</label>
                  <textarea asp-for="ContactForm.Message" rows="5"
                            class="block w-full rounded-lg border border-slate-200 px-4 py-3 text-sm text-slate-900
                                   bg-slate-50 placeholder-slate-400
                                   focus:outline-none focus:border-violet-400 focus:ring-1 focus:ring-violet-400
                                   transition-all resize-none" placeholder="Tell us about your project..."></textarea>
                  <span asp-validation-for="ContactForm.Message" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Submit -->
                <div class="pt-2">
                  <button type="submit"
                          class="w-full rounded-lg px-6 py-3.5 text-sm font-bold text-white
                                 uppercase tracking-widest transition-all duration-200
                                 hover:opacity-90 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-violet-200/50"
                          style="background:linear-gradient(135deg,#7c3aed 0%,#06b6d4 100%);">
                    Send Message &rarr;
                  </button>
                </div>
              </form>
            }
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
