@page
@model Ent.Web.Pages.AcademyModel
@{
    ViewData["Title"] = "ENT Academy";
}

<div class="bg-white pt-12 pb-24 sm:pt-16 sm:pb-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">

    <!-- Page Header -->
    <div class="mx-auto max-w-2xl lg:text-center mb-16">
      <span class="inline-block text-xs font-bold tracking-widest text-pink-600 uppercase mb-3
                   px-3 py-1 rounded-full bg-pink-50 border border-pink-100">ENT Academy</span>
      <p class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Engineering education <br/>
        <span class="text-slate-400 font-light">for the next generation</span>
      </p>
      <p class="mt-8 text-lg leading-8 text-slate-500 font-medium">
        Empowering the next generation of engineering leaders with industry-focused, hands-on courses designed by practitioners.
      </p>
    </div>

    <!-- Courses Grid -->
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <div class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-2">

        <!-- Quantum Computing -->
        <div id="quantum" class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full" style="background:linear-gradient(90deg,#7c3aed,#06b6d4);"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-violet-50 border border-violet-100 flex items-center justify-center mb-5">
              <svg class="h-5 w-5 text-violet-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 01-.657.643 48.39 48.39 0 01-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 01-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 00-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 01-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 00.657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 01-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 005.427-.63 48.05 48.05 0 00.582-4.717.532.532 0 00-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.959.401v0a.656.656 0 00.658-.663 48.422 48.422 0 00-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 01-.61-.58v0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-violet-600 transition-colors">Quantum Computing</h3>
            <p class="text-slate-500 leading-relaxed text-sm mb-4">
              A comprehensive introduction to quantum computing principles, quantum gates, quantum algorithms (Shor, Grover), and practical applications in engineering. Includes hands-on quantum programming using Qiskit.
            </p>
            <ul class="space-y-1.5 text-sm text-slate-500">
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-violet-400 flex-shrink-0"></span>Quantum gates &amp; circuits</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-violet-400 flex-shrink-0"></span>Quantum algorithms</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-violet-400 flex-shrink-0"></span>Qiskit programming</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-violet-400 flex-shrink-0"></span>Engineering applications</li>
            </ul>
          </div>
          <div class="px-8 pb-8 pt-4 border-t border-slate-100">
            <a href="/Contact?subject=Enquiry%3A%20Quantum%20Computing%20Course" class="inline-flex items-center gap-1.5 text-sm font-bold text-violet-600 hover:text-violet-800 transition-colors uppercase tracking-wide">
              Enquire now <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- CFD Courses -->
        <div id="cfd" class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full" style="background:linear-gradient(90deg,#06b6d4,#db2777);"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-5">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">CFD Courses</h3>
            <p class="text-slate-500 leading-relaxed text-sm mb-4">
              Computational Fluid Dynamics training covering fundamentals through to advanced simulation techniques. Learn industry-standard tools including ANSYS Fluent and OpenFOAM for real-world aerodynamic and thermal analysis.
            </p>
            <ul class="space-y-1.5 text-sm text-slate-500">
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-cyan-400 flex-shrink-0"></span>Fluid mechanics fundamentals</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-cyan-400 flex-shrink-0"></span>ANSYS Fluent &amp; OpenFOAM</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-cyan-400 flex-shrink-0"></span>Aerodynamic simulation</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-cyan-400 flex-shrink-0"></span>Thermal &amp; heat transfer analysis</li>
            </ul>
          </div>
          <div class="px-8 pb-8 pt-4 border-t border-slate-100">
            <a href="/Contact?subject=Enquiry%3A%20CFD%20Course" class="inline-flex items-center gap-1.5 text-sm font-bold text-cyan-600 hover:text-cyan-800 transition-colors uppercase tracking-wide">
              Enquire now <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- CTA Banner -->
    <div class="mt-20 mx-auto max-w-3xl rounded-xl border border-slate-200 bg-slate-50 p-10 text-center shadow-sm">
      <h3 class="text-xl font-bold text-slate-900 mb-3">Not sure which course is right for you?</h3>
      <p class="text-slate-500 text-sm mb-6">Our team will help you find the best learning path for your engineering goals.</p>
      <a href="/Contact" class="inline-flex items-center gap-2 rounded-lg px-7 py-3.5 text-sm font-bold text-white transition-all hover:opacity-90 hover:-translate-y-0.5"
         style="background:linear-gradient(135deg,#7c3aed,#db2777);">
        Talk to an Advisor &rarr;
      </a>
    </div>

  </div>
</div>
