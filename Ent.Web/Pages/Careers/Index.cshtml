@page
@model Ent.Web.Pages.Careers.IndexModel
@{
    ViewData["Title"] = "Join Our Team";
}

<div class="bg-white pt-12 pb-24 sm:pt-16 sm:pb-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:text-center">
      <h2 class="text-xs font-bold tracking-widest text-slate-400 uppercase">Careers</h2>
      <p class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Shape the future of engineering <br/><span class="text-slate-400 font-light">with cutting-edge innovation</span></p>
      <p class="mt-8 text-lg leading-8 text-slate-600 font-medium">
        At Enginuvity Nexus Technologies, we're pushing boundaries in quantum computing, AI, and advanced engineering solutions. Join a team of passionate innovators and make a real impact.
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-3xl sm:mt-20 lg:mt-24">
        @if (Model.Careers != null && Model.Careers.Any(c => c.IsActive))
        {
            <div class="space-y-4">
                @foreach (var job in Model.Careers.Where(c => c.IsActive))
                {
                    <details class="group bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md hover:border-slate-300">
                        <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6 text-slate-900 hover:bg-slate-100 transition-colors">
                            <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-6">
                                <h3 class="text-lg font-bold group-open:text-slate-600 transition-colors">@job.JobTitle</h3>
                                <div class="flex flex-wrap gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
                                    <span class="bg-white border border-slate-200 px-2.5 py-1 rounded-sm">@job.Department</span>
                                    <span class="bg-white border border-slate-200 px-2.5 py-1 rounded-sm">@job.Location</span>
                                </div>
                            </div>
                            <span class="transition group-open:rotate-180">
                                <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                            </span>
                        </summary>
                        <div class="text-slate-600 px-6 pb-6 pt-2 bg-white border-t border-slate-100 text-sm leading-relaxed">
                            <p class="whitespace-pre-line mb-6">@job.Description</p>
                            <div class="border-t border-slate-100 pt-4 mt-6">
                                <a href="/Contact?subject=Application for @Uri.EscapeDataString(job.JobTitle)" class="inline-flex items-center gap-2 text-sm font-bold text-slate-900 hover:text-slate-600 transition-colors uppercase tracking-wide">
                                    Apply for this position
                                    <span aria-hidden="true">&rarr;</span>
                                </a>
                            </div>
                        </div>
                    </details>
                }
            </div>
        }
        else
        {
            <div class="text-center py-16 bg-slate-50 rounded-sm border border-slate-100">
                <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <h3 class="mt-4 text-lg font-bold text-slate-900">Currently there is no vacancy at the moment</h3>
                <p class="mt-2 text-sm text-slate-500 max-w-md mx-auto">We don't have any open positions right now, but we are always looking for talented innovators. Check back soon or connect with us on <a href="https://www.linkedin.com/company/enginuvity-nexus-technologies/" target="_blank" rel="noopener noreferrer" class="text-violet-600 hover:underline">LinkedIn</a>!</p>
                <div class="mt-6">
                    <a href="/Contact" class="text-sm font-bold text-slate-900 hover:text-slate-600 transition-colors uppercase tracking-wider">Contact Us <span aria-hidden="true">&rarr;</span></a>
                </div>
            </div>
        }
    </div>
  </div>
</div>
