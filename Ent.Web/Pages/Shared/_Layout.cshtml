<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enginuvity Nexus Technologies</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (via CLI build) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* =====================================================
           ENT DESIGN SYSTEM — Logo-Derived Color Palette
           Logo gradient: Orange → Magenta → Violet → Cyan
           Strategy: White canvas, accents from logo spectrum
        ===================================================== */
        :root {
            --ent-violet: #7c3aed;
            --ent-violet-light: #ede9fe;
            --ent-cyan: #06b6d4;
            --ent-cyan-light: #ecfeff;
            --ent-magenta: #db2777;
            --ent-orange: #ea580c;
            --ent-ink: #0f172a;
            --ent-slate: #475569;
            --ent-mist: #f8fafc;
        }

        * { font-family: 'Inter', system-ui, sans-serif; }



        /* --- NAVBAR --- */
        #main-header {
            transition: box-shadow 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
        }
        #main-header.scrolled {
            box-shadow: 0 1px 24px 0 rgba(124,58,237,0.07), 0 1px 4px 0 rgba(15,23,42,0.06);
        }

        /* Active nav link indicator */
        .nav-link {
            position: relative;
            color: #475569;
            font-weight: 600;
            font-size: 0.875rem;
            transition: color 0.2s;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0; right: 0;
            height: 2px;
            border-radius: 9999px;
            background: linear-gradient(90deg, var(--ent-violet), var(--ent-cyan));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .nav-link:hover { color: var(--ent-ink); }
        .nav-link:hover::after,
        .nav-link.active::after { transform: scaleX(1); }
        .nav-link.active { color: var(--ent-ink); }

        /* Dropdown animations */
        .dropdown-panel {
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
            /* CRITICAL: solid white, never transparent */
            background: #ffffff !important;
            z-index: 200;
            position: absolute;
        }
        .dropdown-trigger:hover .dropdown-panel,
        .dropdown-trigger:focus-within .dropdown-panel {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        /* Connecting notch (▲) between trigger and panel */
        .dropdown-panel::before {
            content: '';
            position: absolute;
            top: -6px;
            left: 24px;
            width: 12px;
            height: 12px;
            background: #ffffff;
            border-left: 1px solid #e2e8f0;
            border-top: 1px solid #e2e8f0;
            transform: rotate(45deg);
        }
        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 14px;
            font-size: 0.8125rem;
            font-weight: 500;
            color: #475569;
            border-radius: 6px;
            border-left: 2px solid transparent;
            white-space: nowrap;
            transition: background-color 0.15s, color 0.15s, border-color 0.15s, padding-left 0.15s;
        }
        .dropdown-item:hover {
            background-color: var(--ent-violet-light);
            color: var(--ent-violet);
            border-left-color: var(--ent-violet);
            padding-left: 18px;
        }
        .dropdown-item .dot {
            width: 5px; height: 5px;
            border-radius: 50%;
            background: currentColor;
            opacity: 0;
            flex-shrink: 0;
            transition: opacity 0.15s;
        }
        .dropdown-item:hover .dot { opacity: 1; }

        /* Dropdown chevron */
        .dropdown-chevron {
            transition: transform 0.25s cubic-bezier(0.4,0,0.2,1);
        }
        .dropdown-trigger:hover .dropdown-chevron { transform: rotate(180deg); }

        /* CTA Button gradient */
        .btn-ent {
            background: linear-gradient(135deg, var(--ent-violet) 0%, var(--ent-cyan) 100%);
            color: white;
            font-weight: 700;
            font-size: 0.8125rem;
            padding: 10px 20px;
            border-radius: 6px;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s;
            display: inline-block;
        }
        .btn-ent:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.3);
        }

        /* Mobile drawer smooth animation */
        #mobile-drawer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }
        #mobile-drawer.open { max-height: 100vh; }

        /* Mobile dropdown content */
        .mob-dd-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.25s ease;
        }
        .mob-dd-content.open { max-height: 400px; }

        /* Footer link hover accent */
        .footer-link { transition: color 0.2s; color: #64748b; }
        .footer-link:hover { color: var(--ent-violet); }

        /* Footer brand gradient bar */
        .footer-brand-bar {
            height: 3px;
            width: 40px;
            background: linear-gradient(90deg, var(--ent-violet), var(--ent-cyan));
            border-radius: 9999px;
            margin-bottom: 16px;
        }

        /* Scrollbar minimal */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: #f8fafc; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* Selection */
        ::selection { background: var(--ent-violet-light); color: var(--ent-violet); }
    </style>
</head>
