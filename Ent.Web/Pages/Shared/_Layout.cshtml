    <!-- ===================== SCRIPTS ===================== -->
    <script>
    (function () {
        'use strict';

        // ─────────────────────────────────────────────
        // 2. STICKY NAVBAR SCROLL STATE
        // ─────────────────────────────────────────────
        const header = document.getElementById('main-header');
        window.addEventListener('scroll', () => {
            header.classList.toggle('scrolled', window.scrollY > 12);
        }, { passive: true });

        // ─────────────────────────────────────────────
        // 3. ACTIVE NAV LINK HIGHLIGHTING
        // ─────────────────────────────────────────────
        const path = window.location.pathname.toLowerCase();
        document.querySelectorAll('.nav-link').forEach(link => {
            const href = (link.getAttribute('href') || '').toLowerCase();
            if (href && (path === href || (href !== '/' && path.startsWith(href)))) {
                link.classList.add('active');
            }
        });

        // Parent trigger active highlighting
        const triggers = document.querySelectorAll('.dropdown-trigger');
        if (path.startsWith('/industries/')) {
            if (triggers[0]) {
                const btn = triggers[0].querySelector('button.nav-link');
                if (btn) btn.classList.add('active');
            }
        } else if (path.startsWith('/services/')) {
            if (triggers[1]) {
                const btn = triggers[1].querySelector('button.nav-link');
                if (btn) btn.classList.add('active');
            }
        } else if (path.startsWith('/academy/')) {
            if (triggers[2]) {
                const btn = triggers[2].querySelector('button.nav-link');
                if (btn) btn.classList.add('active');
            }
        }

        // ─────────────────────────────────────────────
        // 4. MOBILE HAMBURGER — Animated bars
        // ─────────────────────────────────────────────
        const mobileBtn    = document.getElementById('mobile-menu-btn');
        const mobileDrawer = document.getElementById('mobile-drawer');
        const bars         = mobileBtn ? mobileBtn.querySelectorAll('.hamburger-bar') : [];
        let drawerOpen = false;

        if (mobileBtn && mobileDrawer) {
            mobileBtn.addEventListener('click', () => {
                drawerOpen = !drawerOpen;
                mobileBtn.setAttribute('aria-expanded', drawerOpen);

                if (drawerOpen) {
                    mobileDrawer.classList.add('open');
                    // Animate bars → X
                    bars[0].style.transform = 'rotate(45deg) translate(5px, 5px)';
                    bars[1].style.opacity   = '0';
                    bars[2].style.transform = 'rotate(-45deg) translate(5px, -5px)';
                } else {
                    mobileDrawer.classList.remove('open');
                    bars[0].style.transform = '';
                    bars[1].style.opacity   = '';
                    bars[2].style.transform = '';
                }
            });

            // Close on outside click
            document.addEventListener('click', e => {
                if (drawerOpen && !header.contains(e.target)) {
                    drawerOpen = false;
                    mobileDrawer.classList.remove('open');
                    bars[0].style.transform = '';
                    bars[1].style.opacity   = '';
                    bars[2].style.transform = '';
                    mobileBtn.setAttribute('aria-expanded', false);
                }
            });
        }

        // ─────────────────────────────────────────────
        // 5. MOBILE ACCORDION DROPDOWNS
        // ─────────────────────────────────────────────
        document.querySelectorAll('.mob-dd-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const content  = btn.nextElementSibling;
                const chevron  = btn.querySelector('.mob-chevron');
                const isOpen   = content.classList.contains('open');

                // Close all others
                document.querySelectorAll('.mob-dd-content').forEach(c => c.classList.remove('open'));
                document.querySelectorAll('.mob-chevron').forEach(c => c.style.transform = '');

                if (!isOpen) {
                    content.classList.add('open');
                    chevron.style.transform = 'rotate(180deg)';
                }
            });
        });
    })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
