<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ENT Admin Portal</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-gray-100 font-sans antialiased flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col hidden md:flex">
        <div class="h-16 flex items-center px-6 border-b border-gray-200">
            <a class="font-bold text-xl tracking-tight text-blue-900" asp-page="/Admin/Index">ENT Admin</a>
        </div>
        <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-2">
            <a href="/Admin/Index" class="text-gray-700 hover:bg-blue-50 hover:text-blue-700 group flex items-center px-2 py-2 text-sm font-medium rounded-md">
                Dashboard
            </a>
            <a href="/Admin/Users" class="text-gray-700 hover:bg-blue-50 hover:text-blue-700 group flex items-center px-2 py-2 text-sm font-medium rounded-md">
                User Management
            </a>
            <a href="/Admin/Blog/Index" class="text-gray-700 hover:bg-blue-50 hover:text-blue-700 group flex items-center px-2 py-2 text-sm font-medium rounded-md">
                Blog Admin
            </a>
            <a href="/Admin/Careers/Index" class="text-gray-700 hover:bg-blue-50 hover:text-blue-700 group flex items-center px-2 py-2 text-sm font-medium rounded-md">
                Career Admin
            </a>
        </nav>
        <div class="p-4 border-t border-gray-200">
            <form method="post" asp-page="/Account/Logout">
                <button type="submit" class="w-full text-left text-gray-700 hover:text-red-600 px-2 py-2 text-sm font-medium rounded-md">
                    Logout
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-4 sm:px-6 lg:px-8">
            <h1 class="text-2xl font-semibold text-gray-900">@ViewData["Title"]</h1>
            <div class="flex items-center gap-4">
                <a href="/" class="text-sm font-medium text-blue-600 hover:text-blue-500">Back to Public Site</a>
                <span class="text-gray-500 text-sm border-l pl-4">@User.Identity?.Name</span>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            @RenderBody()
        </main>
    </div>
</body>
</html>
