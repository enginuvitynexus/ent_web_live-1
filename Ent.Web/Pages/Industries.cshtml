@page
@model Ent.Web.Pages.IndustriesModel
@{
    ViewData["Title"] = "Industries We Serve";
}

<div class="bg-white pt-12 pb-24 sm:pt-16 sm:pb-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:text-center">
      <h2 class="text-xs font-bold tracking-widest text-slate-400 uppercase">Industries</h2>
      <p class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Engineering Intelligence <br/><span class="text-slate-400 font-light">across global sectors</span></p>
      <p class="mt-8 text-lg leading-8 text-slate-600 font-medium">
        We empower a diverse range of critical industries with next-generation AI, quantum computing, and advanced engineering technologies to solve complex challenges.
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <div class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
        
        <!-- Aerospace -->
        <div class="flex flex-col bg-white overflow-hidden rounded-xl border border-slate-200 shadow-sm hover:border-slate-300 hover:shadow-md transition-all group">
          <div class="p-8 flex-grow">
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-slate-700 transition-colors">Aerospace & Defense</h3>
            <p class="text-slate-600 leading-relaxed text-sm">Advanced CFD simulations, lightweight materials analysis, and digital twin modeling for next-generation aircraft and defense systems.</p>
          </div>
          <div class="px-8 pb-8 mt-auto">
            <a href="/Contact" class="text-sm font-semibold text-slate-900 group-hover:text-slate-600 transition-colors flex items-center gap-2">Learn more <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>

        <!-- Automotive -->
        <div class="flex flex-col bg-white overflow-hidden rounded-xl border border-slate-200 shadow-sm hover:border-slate-300 hover:shadow-md transition-all group">
          <div class="p-8 flex-grow">
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-slate-700 transition-colors">Automotive & Mobility</h3>
            <p class="text-slate-600 leading-relaxed text-sm">Electric vehicle engineering, autonomous driving AI integration, and smart manufacturing process optimization for the mobility sector.</p>
          </div>
          <div class="px-8 pb-8 mt-auto">
            <a href="/Contact" class="text-sm font-semibold text-slate-900 group-hover:text-slate-600 transition-colors flex items-center gap-2">Learn more <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>

        <!-- Energy -->
        <div class="flex flex-col bg-white overflow-hidden rounded-xl border border-slate-200 shadow-sm hover:border-slate-300 hover:shadow-md transition-all group">
          <div class="p-8 flex-grow">
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-slate-700 transition-colors">Energy & Utilities</h3>
            <p class="text-slate-600 leading-relaxed text-sm">Renewable energy simulations, smart grid infrastructure modeling, and predictive maintenance for critical power generation assets.</p>
          </div>
          <div class="px-8 pb-8 mt-auto">
            <a href="/Contact" class="text-sm font-semibold text-slate-900 group-hover:text-slate-600 transition-colors flex items-center gap-2">Learn more <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>

        <!-- Machinery -->
        <div class="flex flex-col bg-white overflow-hidden rounded-xl border border-slate-200 shadow-sm hover:border-slate-300 hover:shadow-md transition-all group">
          <div class="p-8 flex-grow">
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-slate-700 transition-colors">Heavy Machinery</h3>
            <p class="text-slate-600 leading-relaxed text-sm">Finite Element Analysis (FEA) for structural integrity, robotics integration, and industrial IoT solutions for heavy equipment.</p>
          </div>
          <div class="px-8 pb-8 mt-auto">
            <a href="/Contact" class="text-sm font-semibold text-slate-900 group-hover:text-slate-600 transition-colors flex items-center gap-2">Learn more <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>

        <!-- Marine -->
        <div class="flex flex-col bg-white overflow-hidden rounded-xl border border-slate-200 shadow-sm hover:border-slate-300 hover:shadow-md transition-all group">
          <div class="p-8 flex-grow">
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-slate-700 transition-colors">Marine & Offshore</h3>
            <p class="text-slate-600 leading-relaxed text-sm">Hydrodynamic optimization, structural analysis of offshore platforms, and decarbonization strategies for maritime transport.</p>
          </div>
          <div class="px-8 pb-8 mt-auto">
            <a href="/Contact" class="text-sm font-semibold text-slate-900 group-hover:text-slate-600 transition-colors flex items-center gap-2">Learn more <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>

        <!-- Semiconductors -->
        <div class="flex flex-col bg-white overflow-hidden rounded-xl border border-slate-200 shadow-sm hover:border-slate-300 hover:shadow-md transition-all group">
          <div class="p-8 flex-grow">
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-slate-700 transition-colors">Semiconductors</h3>
            <p class="text-slate-600 leading-relaxed text-sm">Thermal management simulations, cleanroom airflow analysis, and nanoscale engineering support for chip manufacturing.</p>
          </div>
          <div class="px-8 pb-8 mt-auto">
            <a href="/Contact" class="text-sm font-semibold text-slate-900 group-hover:text-slate-600 transition-colors flex items-center gap-2">Learn more <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
