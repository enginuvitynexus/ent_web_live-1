@page
@model Ent.Web.Pages.Admin.Blog.DeleteModel
@{
    ViewData["Title"] = "Delete Blog Post";
    Layout = "_AdminLayout";
}

<div class="max-w-xl bg-white p-8 rounded-lg shadow-sm border border-red-200">
    <div class="sm:flex sm:items-start">
        <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
            <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
            <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">Delete Blog Post</h3>
            <div class="mt-2">
                <p class="text-sm text-gray-500">Are you sure you want to delete the blog post "<strong>@Model.BlogPost.Title</strong>"? This action cannot be undone.</p>
            </div>
        </div>
    </div>
    <div class="mt-5 sm:ml-10 sm:mt-4 sm:flex sm:pl-4 gap-3">
        <form method="post">
            <input type="hidden" asp-for="BlogPost.Id" />
            <button type="submit" class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:w-auto">Delete</button>
        </form>
        <a href="/Admin/Blog/Index" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">Cancel</a>
    </div>
</div>
