@page
@model Ent.Web.Pages.ServicesModel
@{
    ViewData["Title"] = "Software Solutions & Services";
}

<div class="bg-white pt-12 pb-24 sm:pt-16 sm:pb-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:text-center">
      <h2 class="text-xs font-bold tracking-widest text-slate-400 uppercase">Capabilities</h2>
      <p class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Our Technological Services <br/><span class="text-slate-400 font-light">for advanced engineering</span></p>
      <p class="mt-8 text-lg leading-8 text-slate-600 font-medium">
        From quantum computational algorithms to cognitive enterprise systems, we design and deploy cutting-edge technological solutions that solve complex mathematical and engineering challenges.
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <div class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:max-w-none lg:grid-cols-4">
        
        <!-- Capability 1 -->
        <div class="flex flex-col items-start bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:border-slate-300 hover:shadow-md transition-all group">
          <div class="rounded-full bg-white p-3 shadow-sm border border-slate-100 mb-6 group-hover:border-cyan-200 transition-colors">
            <svg class="h-6 w-6 text-slate-700 group-hover:text-cyan-600 transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
