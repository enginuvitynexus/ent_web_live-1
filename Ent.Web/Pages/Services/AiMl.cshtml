@page
@model Ent.Web.Pages.Services.AiMlModel
@{
    ViewData["Title"] = "AI & Machine Learning";
}

<div class="bg-white pt-12 pb-24 sm:pt-16 sm:pb-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <!-- Page Header -->
    <div class="mx-auto max-w-2xl lg:text-center mb-16">
      <span class="inline-block text-xs font-bold tracking-widest text-cyan-600 uppercase mb-3
                   px-3 py-1 rounded-full bg-cyan-50 border border-cyan-100">Services</span>
      <p class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        AI &amp; Machine Learning
      </p>
      <p class="mt-3 text-lg text-slate-400 font-light tracking-wide">
        Intelligent systems that learn, adapt, and drive business innovation
      </p>
      <p class="mt-8 text-base leading-8 text-slate-600 font-medium">
        Transform your business with state-of-the-art AI and machine learning solutions. From predictive analytics to computer vision, we develop intelligent systems that automate processes, generate insights, and create unprecedented value.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <div class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-3">

        <!-- Card 1 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l.707.707m2.808 9.905a3.5 3.5 0 115.385 0" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Deep Learning &amp; Neural Networks</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Advanced neural architectures including CNNs, RNNs, transformers, and GANs. Custom model development for image recognition, language processing, and time-series prediction.
            </p>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Predictive Analytics</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Statistical modeling, regression analysis, and forecasting systems. Demand prediction, risk assessment, and business intelligence solutions.
            </p>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Computer Vision</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Object detection, image classification, semantic segmentation, and facial recognition. Quality inspection, autonomous systems, and medical imaging applications.
            </p>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.43.133-.865.129-1.3A8.25 8.25 0 013 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Natural Language Processing</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Text analysis, sentiment analysis, chatbots, and language translation. Information extraction, document classification, and intelligent search systems.
            </p>
          </div>
        </div>

        <!-- Card 5 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196 7.5 7.5 0 0010.607 16.597z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Anomaly Detection</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Fraud detection, network intrusion detection, and quality control. Unsupervised and semi-supervised learning for identifying outliers and abnormal patterns.
            </p>
          </div>
        </div>

        <!-- Card 6 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.047 8.287 8.287 0 009 9.6a8.25 8.25 0 016.362-4.386z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Recommendation Systems</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Collaborative filtering, content-based recommendations, and hybrid approaches. Personalization engines for e-commerce, media, and enterprise applications.
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- CTA Section -->
    <div class="mt-20 text-center flex justify-center gap-4">
      <a href="/Contact?subject=AI%20ML%20Services" class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors uppercase tracking-wide">
        Transform Your Business &rarr;
      </a>
      <a href="/Services/Simulations" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 hover:text-slate-900 transition-colors uppercase tracking-wide">
        Simulation Services
      </a>
    </div>

  </div>
</div>
