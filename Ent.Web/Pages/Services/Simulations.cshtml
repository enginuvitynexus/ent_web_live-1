@page
@model Ent.Web.Pages.Services.SimulationsModel
@{
    ViewData["Title"] = "Physics Simulations & Analysis";
}

<div class="bg-white pt-12 pb-24 sm:pt-16 sm:pb-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <!-- Page Header -->
    <div class="mx-auto max-w-2xl lg:text-center mb-16">
      <span class="inline-block text-xs font-bold tracking-widest text-cyan-600 uppercase mb-3
                   px-3 py-1 rounded-full bg-cyan-50 border border-cyan-100">Services</span>
      <p class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Physics Simulations &amp; Analysis
      </p>
      <p class="mt-3 text-lg text-slate-400 font-light tracking-wide">
        High-fidelity fluid dynamics, structural integrity, and thermal modeling
      </p>
      <p class="mt-8 text-base leading-8 text-slate-600 font-medium">
        We specialize in complex physical simulations that replace costly physical prototyping. Our engineers use industry-standard software and custom-built solvers to simulate fluid flows, structural stresses, thermal transfer, and electromagnetic fields.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <div class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-3">

        <!-- Card 1 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12.75a.75.75 0 01-.75-.75 2.25 2.25 0 012.25-2.25h9a2.25 2.25 0 012.25 2.25.75.75 0 01-.75.75H6z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 0L11.293 5.636M14.828 9.172L9.172 14.828m0 0L5.636 11.293m3.536 3.536l3.536 3.536" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Computational Fluid Dynamics (CFD)</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Aerodynamics, combustion, multiphase flows, and turbulence simulations using OpenFOAM, ANSYS Fluent, and custom GPU-accelerated solvers.
            </p>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M3 12h18M5.314 7.686l13.372 8.628M5.314 16.314l13.372-8.628" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Finite Element Analysis (FEA)</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Static structural stress calculations, buckling checks, vibration modal testing, crash simulations, and fatigue failure predictions.
            </p>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.047 8.287 8.287 0 009 9.6a8.25 8.25 0 016.362-4.386z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Thermal Analysis &amp; Heat Transfer</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Conduction, convection, and radiation simulations. Electronic enclosure cooling design, heat exchanger modeling, and HVAC temperature distributions.
            </p>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622a4.5 4.5 0 01-1.242-7.244l4.5-4.5a4.5 4.5 0 016.364 6.364l-1.757 1.757" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Multiphysics Coupling</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Combined physical interactions, including Fluid-Structure Interaction (FSI) for wind load on elastic bodies and electro-thermal coupling in circuits.
            </p>
          </div>
        </div>

        <!-- Card 5 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9s2.015-9 4.5-9m0 0a9.003 9.003 0 018.716 6.747M12 3a9.003 9.003 0 00-8.716 6.747" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Electromagnetic Fields</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              High-frequency RF simulations, antenna gain optimizations, crosstalk calculations, and low-frequency electromagnetic motor magnetic designs.
            </p>
          </div>
        </div>

        <!-- Card 6 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Acoustics &amp; NVH</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Noise, Vibration, and Harshness (NVH) modeling. Structural vibration noise paths, acoustic reflections, and passenger cabin sound mitigation.
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- CTA Section -->
    <div class="mt-20 text-center">
      <a href="/Contact?subject=Simulation%20Services%20Inquiry" class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors uppercase tracking-wide">
        Start Your Project &rarr;
      </a>
    </div>

  </div>
</div>
