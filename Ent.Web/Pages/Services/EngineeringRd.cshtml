@page
@model Ent.Web.Pages.Services.EngineeringRdModel
@{
    ViewData["Title"] = "Engineering Research & Development";
}

<div class="bg-white pt-12 pb-24 sm:pt-16 sm:pb-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <!-- Page Header -->
    <div class="mx-auto max-w-2xl lg:text-center mb-16">
      <span class="inline-block text-xs font-bold tracking-widest text-cyan-600 uppercase mb-3
                   px-3 py-1 rounded-full bg-cyan-50 border border-cyan-100">Services</span>
      <p class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Engineering R&amp;D
      </p>
      <p class="mt-3 text-lg text-slate-400 font-light tracking-wide">
        Advancing product concepts through scientific engineering and prototype optimization
      </p>
      <p class="mt-8 text-base leading-8 text-slate-600 font-medium">
        We partner with your product engineering divisions to accelerate research and development. By linking advanced numerical simulations, materials science modeling, and rigorous virtual prototyping, we help your organization design safer, lighter, and more efficient products.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <div class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-3">

        <!-- Card 1 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z"/>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Prototype Verification</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Translating early conceptual mockups into highly detailed 3D CAD assemblies, resolving interferences and kinetic linkages.
            </p>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l.707.707m2.808 9.905a3.5 3.5 0 115.385 0" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Advanced Materials Modeling</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Simulating stress-strain curves, fatigue properties, and failure behaviors of composite laminates, custom alloys, and polymers.
            </p>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196 7.5 7.5 0 0010.607 16.597z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Aerostructural Optimization</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Linking aerodynamic flow pressure maps with structural FEA models to minimize drag, optimize airfoil thickness, and shave off weight.
            </p>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Experimental Data Analysis</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Processing raw data streams from physical wind tunnel models, vibration shakers, or telemetry feeds using modern signal processing.
            </p>
          </div>
        </div>

        <!-- Card 5 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Product Lifecycle Strategy</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Setting up Product Lifecycle Management (PLM) workflows, specifying BOM hierarchies, and integrating CAD vault controls.
            </p>
          </div>
        </div>

        <!-- Card 6 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Manufacturing Simulation</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Simulating metal stamping, polymer injection flows, and additive manufacturing thermal profiles to identify defects before production.
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- CTA Section -->
    <div class="mt-20 text-center">
      <a href="/Contact?subject=Engineering%20RD%20Inquiry" class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors uppercase tracking-wide">
        Start Your Project &rarr;
      </a>
    </div>

  </div>
</div>
