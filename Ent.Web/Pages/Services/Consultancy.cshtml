@page
@model Ent.Web.Pages.Services.ConsultancyModel
@{
    ViewData["Title"] = "Project Support & Consultancy";
}

<div class="bg-white pt-12 pb-24 sm:pt-16 sm:pb-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <!-- Page Header -->
    <div class="mx-auto max-w-2xl lg:text-center mb-16">
      <span class="inline-block text-xs font-bold tracking-widest text-cyan-600 uppercase mb-3
                   px-3 py-1 rounded-full bg-cyan-50 border border-cyan-100">Services</span>
      <p class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Project Support &amp; Consultancy
      </p>
      <p class="mt-3 text-lg text-slate-400 font-light tracking-wide">
        Strategic technology advisory and dedicated delivery support
      </p>
      <p class="mt-8 text-base leading-8 text-slate-600 font-medium">
        We provide high-impact technical consulting and dedicated project support. Our architects and advisors collaborate closely with your teams to assess technological feasibility, design microservices, run audits, and implement agile processes.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <div class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-3">

        <!-- Card 1 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Feasibility &amp; Strategy</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Analyzing technological ROI, building business cases, evaluating constraints, and planning long-term tech roadmaps.
            </p>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925-3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 006.75 12h.008a3.75 3.75 0 003.742 3.75H12z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Systems Architecture</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Designing microservices networks, specifying schema models, planning database replications, and configuring system security.
            </p>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Agile Delivery Support</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Agile process mentoring, sprint planning support, task estimation facilitation, and cross-team dependency resolution.
            </p>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Technical Audits</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Codebase quality reviews, regulatory compliance assessments (ISO 27001, GDPR), and software license reviews.
            </p>
          </div>
        </div>

        <!-- Card 5 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.62 48.62 0 0112 20.9c2.785 0 5.429-.447 7.9-1.288-.115-2.08-.282-4.148-.5-6.197M4.26 10.147a60.438 60.438 0 0114.98 0M4.26 10.147a48.662 48.662 0 018-1.743 48.66 48.66 0 018 1.743m-13 1h8m-6 3h4m-7.25-9.362L12 3l5.25 1.388A12.03 12.03 0 0121 10.74m-18 0A12.03 12.03 0 017.25 4.388" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Team Upskilling</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Tailored training bootcamps on microservices, cloud deployments, C# best practices, and integration of AI frameworks.
            </p>
          </div>
        </div>

        <!-- Card 6 -->
        <div class="flex flex-col bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-slate-300 transition-all group">
          <div class="h-1 w-full bg-cyan-500"></div>
          <div class="p-8 flex-grow">
            <div class="w-10 h-10 rounded-lg bg-cyan-50 border border-cyan-100 flex items-center justify-center mb-6">
              <svg class="h-5 w-5 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5L12 10 5 7.5M12 10v11m0-11L5 7.5m7 2.5l7-2.5M21 7.5v9a3 3 0 01-3 3H6a3 3 0 01-3-3v-9a3 3 0 013-3h12a3 3 0 013 3z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-cyan-600 transition-colors">Vendor Selection Support</h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Gathering technical requirements, writing RFP documents, evaluating vendor proposals, and scoring system architectures.
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- CTA Section -->
    <div class="mt-20 text-center">
      <a href="/Contact?subject=Consultancy%20Support%20Inquiry" class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors uppercase tracking-wide">
        Start Your Project &rarr;
      </a>
    </div>

  </div>
</div>
