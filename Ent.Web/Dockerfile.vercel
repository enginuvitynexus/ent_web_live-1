# ============================================================
# Vercel Container Deployment Dockerfile
# ============================================================
# This file is used ONLY for Vercel deployments.
# The original Dockerfile is preserved for OVH / docker-compose.
#
# Key difference from the original:
#   - Does NOT hardcode ASPNETCORE_URLS — Vercel injects $PORT
#     at runtime and Program.cs reads it via Environment.GetEnvironmentVariable("PORT")
#   - EXPOSE uses 8080 as documentation only; Vercel overrides the port
# ============================================================

# ── Build Stage ──────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Install Node.js 20 (required for Tailwind CSS compilation)
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install npm dependencies first (layer-cached unless package.json changes)
COPY package*.json ./
RUN npm ci

# Restore .NET dependencies (layer-cached unless .csproj changes)
COPY ["Ent.Web.csproj", "./"]
RUN dotnet restore "./Ent.Web.csproj"

# Copy remaining source and publish Release build
COPY . .
RUN dotnet publish "Ent.Web.csproj" -c Release -o /app/publish /p:UseAppHost=false

# ── Runtime Stage ─────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

# PORT is injected by Vercel at runtime — Program.cs reads it.
# ASPNETCORE_URLS is intentionally NOT hardcoded here so Vercel's $PORT is honoured.
EXPOSE 8080

ENTRYPOINT ["dotnet", "Ent.Web.dll"]
